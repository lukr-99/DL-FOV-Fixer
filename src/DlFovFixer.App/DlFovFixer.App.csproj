<Project Sdk="Microsoft.NET.Sdk">
  <!-- The WPF tray shell and the only composition root. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>DlFovFixer.App</RootNamespace>
    <!-- The same file name as the 1.x executable. -->
    <AssemblyName>DL-FOV-Fixer</AssemblyName>
    <ApplicationIcon>$(RepositoryRoot)assets\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!--
    The publisher an update installer must be signed by: the common name of the code-signing
    certificate (ADR 0003). Set DLFOVFIXER_PUBLISHER or pass -p:DlFovFixerPublisher=... A build
    without one cannot update itself and offers the releases page instead. A release build without
    one is refused, because 2.x installers are always signed (ADR 0002).
  -->
  <PropertyGroup>
    <DlFovFixerPublisher Condition="'$(DlFovFixerPublisher)' == ''">$(DLFOVFIXER_PUBLISHER)</DlFovFixerPublisher>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="DlFovFixer.Publisher" Value="$(DlFovFixerPublisher)" />
  </ItemGroup>

  <Target Name="RequirePublisherForRelease"
          BeforeTargets="CoreCompile"
          Condition="'$(DlFovFixerReleaseBuild)' == 'true' and '$(DlFovFixerPublisher)' == ''">
    <Error Text="Release builds need the update publisher. Set DLFOVFIXER_PUBLISHER to the common name of the code-signing certificate." />
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="DlFovFixer.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The notification area icon. WPF has none of its own. -->
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <!-- Light, dark and high-contrast styles for the menu and the dialogs, as GoalMaker uses. -->
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DlFovFixer.Core\DlFovFixer.Core.csproj" />
    <ProjectReference Include="..\DlFovFixer.Infrastructure\DlFovFixer.Infrastructure.csproj" />
  </ItemGroup>
</Project>
