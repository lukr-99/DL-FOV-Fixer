<Project Sdk="Microsoft.NET.Sdk">
  <!-- The WPF tray shell and the only composition root. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>DlFovFixer.App</RootNamespace>
    <!-- The same file name as the 1.x executable. -->
    <AssemblyName>DL-FOV-Fixer</AssemblyName>
    <ApplicationIcon>$(RepositoryRoot)assets\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!--
    The public key an update manifest must be signed with (ADR 0006), read from
    contracts/keys/release-manifest-public.b64. tools/setup-update-signing.ps1 made it, and the
    private key stays offline and in the release workflow's secret. A release build without it is
    refused, because it could never trust an update.
  -->
  <PropertyGroup>
    <_ManifestKeyFile>$(RepositoryRoot)contracts\keys\release-manifest-public.b64</_ManifestKeyFile>
    <DlFovFixerManifestPublicKey Condition="'$(DlFovFixerManifestPublicKey)' == '' and Exists('$(_ManifestKeyFile)')">$([System.IO.File]::ReadAllText('$(_ManifestKeyFile)').Trim())</DlFovFixerManifestPublicKey>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="DlFovFixer.ManifestPublicKey" Value="$(DlFovFixerManifestPublicKey)" />
  </ItemGroup>

  <Target Name="RequireManifestKeyForRelease"
          BeforeTargets="CoreCompile"
          Condition="'$(DlFovFixerReleaseBuild)' == 'true' and '$(DlFovFixerManifestPublicKey)' == ''">
    <Error Text="Release builds need the update manifest key in contracts/keys/release-manifest-public.b64. See tools/setup-update-signing.ps1." />
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="DlFovFixer.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The notification area icon. WPF has none of its own. -->
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <!-- Light, dark and high-contrast styles for the menu and the dialogs, as GoalMaker uses. -->
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DlFovFixer.Core\DlFovFixer.Core.csproj" />
    <ProjectReference Include="..\DlFovFixer.Infrastructure\DlFovFixer.Infrastructure.csproj" />
  </ItemGroup>
</Project>
