<Window x:Class="DlFovFixer.App.Shell.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About DL FOV Fixer"
        Width="480" SizeToContent="Height" MaxHeight="680"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        FontFamily="Segoe UI" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Tray.TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Tray.OnPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource Tray.OnPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="#22000000" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,24">

            <!-- Hero: the vision cone the tray icon is drawn from, the name and the version. -->
            <Grid Margin="0,0,0,20">
                <Path Data="M 0,60 L 140,0 L 140,120 Z" Fill="{DynamicResource Tray.PrimaryBrush}"
                      Opacity="0.14" HorizontalAlignment="Right" VerticalAlignment="Center"
                      Stretch="Uniform" Height="64" Margin="0,0,0,40" IsHitTestVisible="False" />
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="NameText" FontSize="28" FontWeight="Bold"
                                   Foreground="{DynamicResource Tray.TextPrimaryBrush}"
                                   AutomationProperties.HeadingLevel="Level1" />
                        <Border Background="{DynamicResource Tray.SurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource Tray.BorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="VersionText" FontSize="12"
                                       Foreground="{DynamicResource Tray.PrimaryBrush}" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                    <Rectangle Height="3" Width="48" Margin="0,10,0,12" HorizontalAlignment="Left" RadiusX="1.5" RadiusY="1.5"
                               Fill="{DynamicResource Tray.PrimaryBrush}" />
                    <TextBlock x:Name="TaglineText" TextWrapping="Wrap" FontSize="14" LineHeight="21"
                               Foreground="{DynamicResource Tray.TextSecondaryBrush}" MaxWidth="400" HorizontalAlignment="Left" />
                </StackPanel>
            </Grid>

            <!-- The author's card, the one filled block on the page. -->
            <Border Background="{DynamicResource Tray.PrimaryBrush}" CornerRadius="14" Padding="22,20" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="MADE BY" FontSize="11" FontWeight="SemiBold" Opacity="0.8"
                               Foreground="{DynamicResource Tray.OnPrimaryBrush}" />
                    <TextBlock x:Name="AuthorText" FontSize="24" FontWeight="Bold" Margin="0,2,0,8"
                               Foreground="{DynamicResource Tray.OnPrimaryBrush}" />
                    <TextBlock x:Name="FeedbackText" TextWrapping="Wrap" FontSize="14" LineHeight="21" Margin="0,0,0,16"
                               Foreground="{DynamicResource Tray.OnPrimaryBrush}" />
                    <ItemsControl x:Name="LinkList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource LinkButton}" Tag="{Binding Url}"
                                        Click="OnLinkClick" Margin="0,0,8,8"
                                        AutomationProperties.Name="{Binding Label}" ToolTip="{Binding Url}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="{Binding Handle}" FontSize="11" Opacity="0.85" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- What the app is doing right now. -->
            <TextBlock Text="RIGHT NOW" Style="{StaticResource Caption}" />
            <ItemsControl x:Name="FactList" Margin="0,0,0,24">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Tray.TextSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Tray.TextPrimaryBrush}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Credits and licences. -->
            <TextBlock Text="CREDITS AND LICENCES" Style="{StaticResource Caption}" />
            <ItemsControl x:Name="CreditList" Margin="0,0,0,20">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource Tray.BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Tray.TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding Role}" FontSize="12"
                                               Foreground="{DynamicResource Tray.TextSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding License}" FontSize="12" VerticalAlignment="Center"
                                           TextAlignment="Right" TextWrapping="Wrap" MaxWidth="190"
                                           Foreground="{DynamicResource Tray.TextSecondaryBrush}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="DisclaimerText" TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource Tray.TextSecondaryBrush}" Margin="0,0,0,16" />
            <Button Content="Close" IsCancel="True" IsDefault="True" HorizontalAlignment="Right"
                    Padding="20,6" Click="OnCloseClick" />
        </StackPanel>
    </ScrollViewer>
</Window>
